+/** Strip presentation effects from a private copy for static WASM output only. */
+function staticPresentation(bytes) {
+	const parts = unzipSync(bytes, { filter: ({ name }) => /^ppt\/(?:slides|slideLayouts|slideMasters)\/[^/]+\.xml$/u.test(name) });
+	const changes = new Map();
+	for (const [name, data] of Object.entries(parts)) {
+		const encoding = data[0] === 255 && data[1] === 254 || data[0] === 60 && data[1] === 0 ? "utf-16le"
+			: data[0] === 254 && data[1] === 255 || data[0] === 0 && data[1] === 60 ? "utf-16be" : "utf-8";
+		const xml = new TextDecoder(encoding, { ignoreBOM: true, fatal: true }).decode(data);
+		const parser = new SaxesParser({ xmlns: true });
+		const kept = [];
+		let start, open, depth = 0, cursor = 0;
+		parser.on("opentagstart", () => { open = xml.lastIndexOf("<", parser.position - 1); });
+		parser.on("opentag", ({ local, uri }) => {
+			if (depth) depth++;
+			else if ((local === "transition" || local === "timing") &&
+				(uri === "http://schemas.openxmlformats.org/presentationml/2006/main" || uri === "http://purl.oclc.org/ooxml/presentationml/main")) {
+				start = open;
+				depth = 1;
+			}
+		});
+		parser.on("closetag", () => {
+			if (depth && --depth === 0) {
+				kept.push(xml.slice(cursor, start));
+				cursor = parser.position;
+			}
+		});
+		parser.write(xml).close();
+		if (cursor) {
+			const text = kept.join("") + xml.slice(cursor);
+			const encoded = Buffer.from(text, encoding === "utf-8" ? "utf8" : "utf16le");
+			changes.set(name, encoding === "utf-16be" ? encoded.swap16() : encoded);
+		}
+	}
+	if (changes.size === 0) return bytes;
+	const files = unzipSync(bytes);
+	for (const [name, data] of changes) files[name] = data;
+	return zipSync(files);
+}
